{
  "name": "nightshift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "services",
    "healer"
  ],
  "scripts": {
    "healer": "npm run start --workspace @nightshift/healer",
    "services": "tsx services/src/start-all.ts",
    "traffic": "tsx services/src/traffic.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
