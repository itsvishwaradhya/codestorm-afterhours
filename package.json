{
  "name": "nightshift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "services",
    "healer",
    "dashboard"
  ],
  "scripts": {
    "start": "concurrently -k -n healer,traffic,dashboard -c cyan,green,magenta \"npm run healer\" \"npm run traffic\" \"npm run dashboard\"",
    "reset": "tsx scripts/reset.ts",
    "healer": "npm run start --workspace @nightshift/healer",
    "dashboard": "npm run dev --workspace @nightshift/dashboard",
    "services": "tsx services/src/start-all.ts",
    "traffic": "tsx services/src/traffic.ts",
    "scenario": "tsx scripts/scenario.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
