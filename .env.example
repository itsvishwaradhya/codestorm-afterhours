# Copy this file to .env and uncomment what you need. Everything has a working default.

# Where the healer listens, and where services and the dashboard find it.
# HEALER_PORT=4000
# HEALER_URL=http://localhost:4000
# DASHBOARD_PORT=5173

# Leave MONGODB_URI unset to use the embedded MongoDB (no install needed).
# MONGODB_URI=mongodb://127.0.0.1:27017/nightshift

# Synthetic checkout traffic, requests per second.
# TRAFFIC_RPS=2

# Safety limits.
# ACTION_CAP_MAX=3
# ACTION_CAP_WINDOW_MINUTES=10
# APPROVAL_TIMEOUT_MINUTES=15
# WATCH_SECONDS=60

# Optional receipt wording. The template receipt is always written first; these keys
# only let a free-tier model reword it. The LLM never chooses or applies a fix.
# LLM_ENABLED=true
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
